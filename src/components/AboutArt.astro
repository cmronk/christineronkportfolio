    <path class="steam d3" d="M216,84 C208,72 224,64 216,50"></path>
  </g>

  <!-- 4. The mug -->
  <!-- Saucer -->
  <ellipse cx="196" cy="204" rx="72" ry="12" fill="#C9B793" stroke="#2A2118" stroke-width="3"></ellipse>
  <ellipse cx="196" cy="200" rx="52" ry="7" fill="#EADBC0"></ellipse>
  <!-- Handle: a thick ink stroke with a terracotta stroke inside it -->
