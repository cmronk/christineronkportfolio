  </g>
  <g class="badge back b-faith">
    <circle r="18" fill="#F7EBDB"></circle>
    <circle cx="-10.8" cy="-9.6" r="2.4" fill="#E9DCC6"></circle><circle cx="10.8" cy="10.8" r="1.9" fill="#E9DCC6"></circle>
    <path d="M0,-18 A18,18 0 0 1 0,18 A12.6,18 0 0 0 0,-18 Z" fill="#2A2118" opacity="0.12"></path>
    <circle r="18" fill="none" stroke="#2A2118" stroke-width="2.5"></circle>
    <path d="M-2,-11 H2 V-5 H7 V-1 H2 V11 H-2 V-1 H-7 V-5 H-2 Z" fill="#D4A23A" stroke="#2A2118" stroke-width="1.8" stroke-linejoin="round"></path>
  </g>

  <!-- 3. Steam rising from the mug -->
  <g fill="none" stroke="#8C7A5E" stroke-width="4" stroke-linecap="round" opacity="0.55">
    <path class="steam" d="M176,84 C168,72 184,64 176,50"></path>
