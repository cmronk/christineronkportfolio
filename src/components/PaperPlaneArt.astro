---
// Sidebar illustration: a paper airplane flies from a little church to a
// little house, once for each year, and each trip is quicker than the last.
// When it lands, the house's window lights up and a heart pops above it.
// Used on the Connections Dashboard case study.
//
// Props:
//   trips    the years to fly, in order. Each has a label and a number of days.
//            Flight time is scaled from the days, so shorter waits fly faster.
//   caption  line under the drawing
//
// It starts when it scrolls into view, plays once, and "Replay" runs it again.
// Visitors with reduced motion see the last trip already landed.
//
// Note: the plane is moved by setting its transform attribute from the script
// (not CSS offset-path), which works the same in every browser.
interface Trip { label: string; days: number; }
interface Props { trips?: Trip[]; caption?: string; }
const {
  trips = [
    { label: '2021', days: 48 },
    { label: '2022', days: 22 },
    { label: '2023', days: 8 },
  ],
  caption = 'Average wait for a new person’s first contact',
} = Astro.props;
const last = trips[trips.length - 1];
const STAR = 'M0,-40 L5,-5 L40,0 L5,5 L0,40 L-5,5 L-40,0 L-5,-5 Z';
---
<figure class="reach" data-reach data-trips={JSON.stringify(trips)}>
  <svg viewBox="0 0 240 230" aria-hidden="true">
    <!-- Soft backdrop circle -->
    <circle cx="120" cy="118" r="98" fill="#E9DCC6"></circle>

    <!-- Flight path: a faint dashed arc from the steeple to the house -->
    <path class="route" d="M80,90 C72,18 124,62 152,98" fill="none" stroke="#56684F" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="5 7" opacity="0.55"></path>

    <!-- Church (bottom left) -->
    <g>
      <path d="M58,124 L74,108 L90,124" fill="#C65A3A" stroke="#2A2118" stroke-width="3" stroke-linejoin="round"></path>
      <rect x="62" y="124" width="24" height="24" fill="#EADBC0" stroke="#2A2118" stroke-width="3"></rect>
      <path d="M74,108 V96 M69,101 H79" stroke="#D4A23A" stroke-width="3.5" stroke-linecap="round"></path>
      <path d="M34,152 L56,134 L112,134 L112,190 L34,190 Z" fill="#EADBC0" stroke="#2A2118" stroke-width="3" stroke-linejoin="round"></path>
      <path d="M28,154 L56,128 L84,154" fill="#C65A3A" stroke="#2A2118" stroke-width="3" stroke-linejoin="round"></path>
      <path d="M66,190 V170 A8,8 0 0 1 82,170 V190" fill="#C9B793" stroke="#2A2118" stroke-width="3"></path>
      <path d="M44,166 A5,5 0 0 1 54,166 V176 H44 Z" fill="#2F3B33" stroke="#2A2118" stroke-width="2"></path>
      <path d="M94,148 A5,5 0 0 1 104,148 V160 H94 Z" fill="#2F3B33" stroke="#2A2118" stroke-width="2"></path>
    </g>

    <!-- House (top right) -->
    <g>
      <rect x="160" y="84" width="44" height="36" fill="#F7EBDB" stroke="#2A2118" stroke-width="3"></rect>
      <path d="M154,86 L182,62 L210,86" fill="#56684F" stroke="#2A2118" stroke-width="3" stroke-linejoin="round"></path>
      <rect x="190" y="64" width="8" height="12" fill="#C9B793" stroke="#2A2118" stroke-width="2.5"></rect>
      <rect x="166" y="96" width="14" height="12" fill="#2F3B33" stroke="#2A2118" stroke-width="2"></rect>
      <rect class="window-glow" x="166" y="96" width="14" height="12" fill="#D4A23A" stroke="#2A2118" stroke-width="2"></rect>
      <path d="M173,96 V108 M166,102 H180" stroke="#2A2118" stroke-width="1.5"></path>
      <rect x="186" y="102" width="10" height="18" fill="#C65A3A" stroke="#2A2118" stroke-width="2"></rect>
    </g>

    <!-- Heart that pops when the plane lands -->
    <g class="heart-pop">
      <path d="M182,52 C172,44 172,34 178,34 C181,34 182,36 182,38 C182,36 183,34 186,34 C192,34 192,44 182,52 Z" fill="#C65A3A" stroke="#2A2118" stroke-width="2" stroke-linejoin="round"></path>
    </g>

    <!-- Paper airplane, drawn pointing right around (0,0). The script moves it. -->
    <g class="plane" transform="translate(152,98)">
      <path d="M13,0 L-11,-9 L-5,0 Z" fill="#FFFAF2" stroke="#2A2118" stroke-width="2" stroke-linejoin="round"></path>
      <path d="M13,0 L-11,9 L-5,0 Z" fill="#C9B793" stroke="#2A2118" stroke-width="2" stroke-linejoin="round"></path>
    </g>

    <!-- Sparkles to match the other illustrations -->
    <g transform="translate(30,46) scale(0.28)"><path class="twinkle" d={STAR} fill="#D4A23A"></path></g>
    <g transform="translate(214,184) scale(0.22)"><path class="twinkle d2" d={STAR} fill="#56684F"></path></g>
    <g transform="translate(128,24) scale(0.16)"><path class="twinkle d3" d={STAR} fill="#C65A3A"></path></g>
  </svg>

  <div class="trip" aria-hidden="true">
    <span class="year" data-year>{last.label}</span>
    <span class="days" data-days>{last.days} days</span>
  </div>
  <figcaption>
    {caption}, {trips.map((t) => `${t.label}: ${t.days} days`).join(', ')}.
    <button type="button" class="replay" data-replay>Replay</button>
  </figcaption>
</figure>

<style>
  .reach { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  .reach svg { width: 100%; max-width: 260px; height: auto; overflow: visible; }

  .trip { display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .year { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sage, #56684F); font-weight: 600; }
  .days { font-family: var(--font-display); font-size: 40px; line-height: 1; color: var(--terracotta); font-variant-numeric: tabular-nums; }

  figcaption { font-size: 14px; color: var(--ink-soft); max-width: 30ch; line-height: 1.5; }
  .replay {
    font: inherit; font-size: 14px; background: none; border: 0; padding: 0; margin-left: 4px;
    color: var(--terracotta); text-decoration: underline; cursor: pointer;
  }

  /* Window glow and heart: hidden until the plane lands */
  .window-glow { opacity: 0; transition: opacity .4s ease; }
  .heart-pop {
    opacity: 0;
    transform-box: fill-box; transform-origin: center bottom;
    transform: scale(.4) translateY(6px);
    transition: opacity .35s ease, transform .5s cubic-bezier(.34, 1.56, .64, 1);
  }
  .reach.landed .window-glow { opacity: 1; }
  .reach.landed .heart-pop { opacity: 1; transform: none; }
  .plane { transition: opacity .3s ease; }
  .reach.between .plane { opacity: 0; }

  @media (prefers-reduced-motion: reduce) {
    .window-glow, .heart-pop, .plane { transition: none; }
  }
</style>

<script>
  type Trip = { label: string; days: number };
  const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2); // ease-in-out
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  document.querySelectorAll<HTMLElement>('[data-reach]').forEach((el) => {
    const trips: Trip[] = JSON.parse(el.dataset.trips || '[]');
    const route = el.querySelector<SVGPathElement>('.route')!;
    const plane = el.querySelector<SVGGElement>('.plane')!;
    const yearEl = el.querySelector<HTMLElement>('[data-year]')!;
    const daysEl = el.querySelector<HTMLElement>('[data-days]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const len = route.getTotalLength();
    const maxDays = Math.max(...trips.map((t) => t.days));
    let run = 0; // bumps on every replay so an old run stops

    // Place the plane at a share of the route, pointing along it
    function place(p: number) {
      const a = route.getPointAtLength(Math.max(0, p * len - 1));
      const b = route.getPointAtLength(Math.min(len, p * len + 1));
      const angle = (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
      const pt = route.getPointAtLength(p * len);
      plane.setAttribute('transform', `translate(${pt.x.toFixed(1)},${pt.y.toFixed(1)}) rotate(${angle.toFixed(1)})`);
    }

    function show(trip: Trip) {
      yearEl.textContent = trip.label;
      daysEl.textContent = `${trip.days} days`;
    }

    function fly(ms: number, id: number) {
      return new Promise<void>((resolve) => {
        const start = performance.now();
        const step = (now: number) => {
          if (id !== run) return resolve();
          const t = Math.min(1, (now - start) / ms);
          place(ease(t));
          if (t < 1) requestAnimationFrame(step); else resolve();
        };
        requestAnimationFrame(step);
      });
    }

    async function play() {
      const id = ++run;
      for (const trip of trips) {
        if (id !== run) return;
        el.classList.remove('landed');
        el.classList.add('between');
        place(0);
        show(trip);
        await wait(350);
        el.classList.remove('between');
        // Longest wait flies in about 3.6s, shorter waits scale down to a 1.1s minimum
        await fly(Math.max(1100, (trip.days / maxDays) * 3600), id);
        if (id !== run) return;
        el.classList.add('landed');
        await wait(1100);
      }
    }

    function finalState() {
      run++;
      show(trips[trips.length - 1]);
      place(1);
      el.classList.remove('between');
      el.classList.add('landed');
    }

    finalState();
    if (!reduce) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { play(); io.disconnect(); }
      }, { threshold: 0.5 });
      io.observe(el);
    }
    el.querySelector('[data-replay]')?.addEventListener('click', () => (reduce ? finalState() : play()));
  });
</script>
