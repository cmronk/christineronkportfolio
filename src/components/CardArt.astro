---
// Small placeholder illustrations for article and case study cards.
// `variant` cycles through palettes. `shape` is "banner" (cards) or "square" (article header).
interface Props { variant?: number; shape?: 'banner' | 'square' }
const palettes = [
  { bg: '#C65A3A', planet: '#D4A23A', ring: '#F7EBDB', ground: '#56684F' },
  { bg: '#56684F', planet: '#D4A23A', ring: '#C65A3A', ground: '#C65A3A' },
  { bg: '#2F3B33', planet: '#C65A3A', ring: '#D4A23A', ground: '#D4A23A' },
  { bg: '#D4A23A', planet: '#56684F', ring: '#2A2118', ground: '#C65A3A' },
];
const p = palettes[(Astro.props.variant ?? 0) % palettes.length];
const square = Astro.props.shape === 'square';
const star = 'M0,-40 L5,-5 L40,0 L5,5 L0,40 L-5,5 L-40,0 L-5,-5 Z';
---
{square ? (
  <svg viewBox="0 0 160 160" class="card-art card-art--square" aria-hidden="true">
    <rect width="160" height="160" fill={p.bg}></rect>
    <circle cx="80" cy="70" r="36" fill={p.planet}></circle>
    <ellipse cx="80" cy="70" rx="60" ry="11" fill="none" stroke={p.ring} stroke-width="4" transform="rotate(-16 80 70)"></ellipse>
    <path d="M0,132 C50,118 110,142 160,124 L160,160 L0,160 Z" fill={p.ground}></path>
    <g transform="translate(0,-16)">
      <path d="M34,147 L34,134" stroke="#2A2118" stroke-width="2" stroke-linecap="round"></path>
      <path d="M34,138 C27,131 21,133 21,137 C27,141 31,141 34,138 Z" fill="#A9BFA4" stroke="#2A2118" stroke-width="1.5"></path>
      <path d="M34,136 C41,129 47,131 47,135 C41,139 37,139 34,136 Z" fill="#A9BFA4" stroke="#2A2118" stroke-width="1.5"></path>
    </g>
    <g transform="translate(128,120)">
      <path d="M0,10 L0,-2" stroke="#2A2118" stroke-width="2" stroke-linecap="round"></path>
      <circle cx="0" cy="-8" r="3.5" fill="#F7EBDB"></circle>
      <circle cx="-5" cy="-12" r="3.5" fill="#F7EBDB"></circle>
      <circle cx="5" cy="-12" r="3.5" fill="#F7EBDB"></circle>
      <circle cx="-4" cy="-17" r="3.5" fill="#F7EBDB"></circle>
      <circle cx="4" cy="-17" r="3.5" fill="#F7EBDB"></circle>
      <circle cx="0" cy="-13" r="3" fill="#D4A23A" stroke="#2A2118" stroke-width="1"></circle>
    </g>
    <g transform="translate(130,26) scale(0.3)"><path class="twinkle" d={star} fill="#F7EBDB"></path></g>
    <g transform="translate(28,36) scale(0.16)"><path class="twinkle d2" d={star} fill="#F7EBDB"></path></g>
  </svg>
) : (
  <svg viewBox="0 0 600 160" class="card-art" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
    <rect width="600" height="160" fill={p.bg}></rect>
    <circle cx="300" cy="72" r="40" fill={p.planet}></circle>
    <ellipse cx="300" cy="72" rx="74" ry="13" fill="none" stroke={p.ring} stroke-width="4" transform="rotate(-12 300 72)"></ellipse>
    <path d="M0,135 C150,120 380,150 600,125 L600,160 L0,160 Z" fill={p.ground}></path>
    <g transform="translate(76,-12)">
      <path d="M34,147 L34,134" stroke="#2A2118" stroke-width="2" stroke-linecap="round"></path>
      <path d="M34,138 C27,131 21,133 21,137 C27,141 31,141 34,138 Z" fill="#A9BFA4" stroke="#2A2118" stroke-width="1.5"></path>
      <path d="M34,136 C41,129 47,131 47,135 C41,139 37,139 34,136 Z" fill="#A9BFA4" stroke="#2A2118" stroke-width="1.5"></path>
    </g>
    <g transform="translate(490,128)">
      <path d="M0,10 L0,-2" stroke="#2A2118" stroke-width="2" stroke-linecap="round"></path>
      <circle cx="0" cy="-8" r="3.5" fill="#F7EBDB"></circle>
      <circle cx="-5" cy="-12" r="3.5" fill="#F7EBDB"></circle>
      <circle cx="5" cy="-12" r="3.5" fill="#F7EBDB"></circle>
      <circle cx="-4" cy="-17" r="3.5" fill="#F7EBDB"></circle>
      <circle cx="4" cy="-17" r="3.5" fill="#F7EBDB"></circle>
      <circle cx="0" cy="-13" r="3" fill="#D4A23A" stroke="#2A2118" stroke-width="1"></circle>
    </g>
    <g transform="translate(480,34) scale(0.3)"><path class="twinkle" d={star} fill="#F7EBDB"></path></g>
    <g transform="translate(110,42) scale(0.16)"><path class="twinkle d2" d={star} fill="#F7EBDB"></path></g>
    <g transform="translate(210,26) scale(0.12)"><path class="twinkle" d={star} fill="#F7EBDB"></path></g>
  </svg>
)}

<style>
  .card-art {
    display: block;
    width: 100%;
    height: auto;
    max-height: 220px;
    border-radius: 10px;
  }
  .card-art--square { max-height: none; }
</style>