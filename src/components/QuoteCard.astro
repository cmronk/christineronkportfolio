---
// Sidebar quote card with a little space scene:
//   - a few tiny stars twinkle in the background
//   - a shooting star streaks across every so often
//   - at the bottom, a small planet with a ring, and a moon that orbits it,
//     passing in front of the planet and then behind it
//
// Props:
//   quote   the quote text (no quote marks needed)
//   by      optional attribution, like "Growth Track coordinator"
//
// The moon uses SVG's built-in animation (animateMotion), which works the same
// in every browser, including iOS Safari. For visitors with reduced motion,
// the script pauses it and the CSS stops the twinkles and shooting star.
interface Props { quote: string; by?: string; }
const { quote, by } = Astro.props;
const STAR = 'M0,-40 L5,-5 L40,0 L5,5 L0,40 L-5,5 L-40,0 L-5,-5 Z';

// Moon orbit: an ellipse around the planet at (52,44), tilted with the ring.
// Front half first (right end, down and around to the left), then the back half.
const ORBIT = 'M98,44 A46,14 0 0 1 6,44 A46,14 0 0 1 98,44';
const DUR = '14s';
---
<aside class="quote-card" data-quote-card>
  <!-- Sky along the bottom of the card, beside the planet, so it never sits behind the words -->
  <svg class="sky" viewBox="0 0 300 110" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
    <circle class="dot" cx="196" cy="30" r="1.8"></circle>
    <circle class="dot d2" cx="262" cy="62" r="1.4"></circle>
    <circle class="dot d3" cx="226" cy="84" r="1.2"></circle>
    <circle class="dot d2" cx="282" cy="24" r="1.2"></circle>
    <circle class="dot" cx="166" cy="70" r="1.3"></circle>
    <g class="shooting">
      <path d="M0,0 L-46,-14" stroke="url(#trail)" stroke-width="2" stroke-linecap="round"></path>
      <circle r="2.2" fill="#D4A23A"></circle>
    </g>
    <defs>
      <linearGradient id="trail" x1="0" y1="0" x2="-46" y2="-14" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#D4A23A" stop-opacity="0.9"></stop>
        <stop offset="1" stop-color="#D4A23A" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
  </svg>

  <blockquote>
    <p>“{quote}”</p>
    {by && <footer>{by}</footer>}
  </blockquote>

  <!-- Little planet with an orbiting moon -->
  <svg class="planet" viewBox="0 0 104 80" aria-hidden="true" data-planet>
    <g transform="rotate(-12 52 44)">
      <!-- Back half of the ring, then the moon's back copy, then the planet -->
      <path d="M22,44 A30,9 0 0 1 82,44" fill="none" stroke="#56684F" stroke-width="3" stroke-linecap="round"></path>
      <g>
        <circle r="5" fill="#E9DCC6" stroke="#2A2118" stroke-width="1.8"></circle>
        <animateMotion dur={DUR} repeatCount="indefinite" path={ORBIT}></animateMotion>
        <animate attributeName="opacity" values="0;1" keyTimes="0;0.5" calcMode="discrete" dur={DUR} repeatCount="indefinite"></animate>
      </g>
    </g>
    <circle cx="52" cy="44" r="17" fill="#C65A3A" stroke="#2A2118" stroke-width="2.5"></circle>
    <path d="M42,36 A12,12 0 0 1 50,31" fill="none" stroke="#F7EBDB" stroke-width="2.5" stroke-linecap="round" opacity="0.45"></path>
    <g transform="rotate(-12 52 44)">
      <!-- Front half of the ring, then the moon's front copy -->
      <path d="M82,44 A30,9 0 0 1 22,44" fill="none" stroke="#56684F" stroke-width="3" stroke-linecap="round"></path>
      <g>
        <circle r="5" fill="#E9DCC6" stroke="#2A2118" stroke-width="1.8"></circle>
        <animateMotion dur={DUR} repeatCount="indefinite" path={ORBIT}></animateMotion>
        <animate attributeName="opacity" values="1;0" keyTimes="0;0.5" calcMode="discrete" dur={DUR} repeatCount="indefinite"></animate>
      </g>
    </g>
    <g transform="translate(92,14) scale(0.2)"><path class="twinkle" d={STAR} fill="#C65A3A"></path></g>
  </svg>
</aside>

<style>
  .quote-card {
    overflow: hidden;
    flex: 1 1 260px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 28px 20px;
    position: sticky;
    top: 24px;
  }
  @media (max-width: 800px) { .quote-card { position: relative; } }

  .sky { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 120px; pointer-events: none; }
  .dot { fill: #D4A23A; opacity: .5; animation: dot 3.6s ease-in-out infinite; }
  .dot.d2 { animation-delay: -1.2s; fill: #56684F; }
  .dot.d3 { animation-delay: -2.4s; }
  @keyframes dot { 0%, 100% { opacity: .2; } 50% { opacity: .8; } }

  /* Shooting star: crosses the top of the card once every 9 seconds */
  .shooting { opacity: 0; animation: shoot 9s ease-out infinite 2s; }
  @keyframes shoot {
    0%   { transform: translate(170px, 14px); opacity: 0; }
    3%   { opacity: 1; }
    12%  { transform: translate(320px, 60px); opacity: 0; }
    100% { transform: translate(320px, 60px); opacity: 0; }
  }

  blockquote { position: relative; margin: 0; }
  blockquote p {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 22px;
    line-height: 1.4;
  }
  blockquote footer { margin-top: 12px; font-size: 14px; color: var(--ink-soft); }

  .planet { position: relative; display: block; width: 128px; height: auto; margin: 18px 0 0 -8px; overflow: visible; }

  @media (prefers-reduced-motion: reduce) {
    .dot, .shooting { animation: none; }
  }
</style>

<script>
  // SVG's built-in animations ignore the reduced-motion setting, so pause them here.
  // The moon then rests on the front of the orbit.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('[data-planet]').forEach((svg) => {
      svg.pauseAnimations();
      svg.setCurrentTime(1.2);
    });
  }
</script>
