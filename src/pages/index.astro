---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArt from '../components/HeroArt.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import GrowthTrackArt from '../components/GrowthTrackArt.astro';
import DevotionalArt from '../components/DevotionalArt.astro';
import ConnectionsArt from '../components/ConnectionsArt.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ContactForm from '../components/ContactForm.astro';
import Star from '../components/Star.astro';
import { getArticles, getCaseStudies } from '../lib/content';

const studies = await getCaseStudies();
const featured = studies.find((s) => s.data.featured) ?? studies[0];
const articles = (await getArticles()).slice(0, 2);

const categories = [
  { name: 'Systems & Integrations', blurb: 'Connecting the pieces.', color: 'var(--sage)', icon: 'network' },
  { name: 'Data & Reporting', blurb: 'Turning data into insight.', color: 'var(--mustard)', icon: 'bars' },
  { name: 'Development', blurb: 'Building useful things.', color: 'var(--terracotta-soft)', icon: 'code' },
];
---
<BaseLayout>
  <!-- Hero -->
  <section class="container hero">
    <div class="hero-copy">
      <p class="eyebrow">Systems · Data · Development · Ideas</p>
      <h1>Architecting solutions that serve.</h1>
      <p class="lede">I build practical solutions, connect systems, turn data into insight, and write about what it means to use technology well.</p>
      <a href="/work/" class="btn lift">
        Explore my work
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
    <div class="hero-art"><HeroArt /></div>
  </section>

  <!-- What I work on -->
  <section class="section section--border">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">01 / Selected work</p>
          <h2 class="section-title">What I work on</h2>
        </div>
        <p>Systems, data, and development, with a focus on practical solutions and measurable outcomes.</p>
      </div>
      <div class="cat-grid">
        {categories.map((c) => (
          <a href={`/work/?category=${encodeURIComponent(c.name)}`} class="cat lift" style={`background: ${c.color}`}>
            {c.icon === 'network' && (
              <svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="32" cy="32" r="7" fill="currentColor"></circle><circle cx="32" cy="8" r="5"></circle><circle cx="32" cy="56" r="5"></circle><circle cx="10" cy="20" r="5"></circle><circle cx="54" cy="20" r="5"></circle><circle cx="10" cy="44" r="5"></circle><circle cx="54" cy="44" r="5"></circle><path d="M32 13v12M32 39v12M14 22l12 7M50 22l-12 7M14 42l12-7M50 42l-12-7"></path></svg>
            )}
            {c.icon === 'bars' && (
              <svg width="64" height="64" viewBox="0 0 64 64" aria-hidden="true"><rect x="8" y="38" width="10" height="18" rx="2" fill="currentColor"></rect><rect x="23" y="28" width="10" height="28" rx="2" fill="currentColor"></rect><rect x="38" y="16" width="10" height="40" rx="2" fill="currentColor"></rect><rect x="53" y="6" width="8" height="50" rx="2" fill="none" stroke="currentColor" stroke-width="2.5"></rect></svg>
            )}
            {c.icon === 'code' && (
              <svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 18L6 32l14 14M44 18l14 14-14 14M37 10L27 54"></path></svg>
            )}
            <div>
              <h3>{c.name}</h3>
              <p>{c.blurb}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured case study (whichever one has `featured: true`) -->
  {featured && (
    <section class="section section--tint">
      <div class="container featured">
        <!-- Same visual as the top of the case study page:
             its illustration if it has one, otherwise the before/after slider -->
        <div class="featured-visual">
          {featured.data.illustration === 'connections' ? (
            <ConnectionsArt />
          ) : featured.data.illustration === 'growth-track' ? (
            <GrowthTrackArt />
          ) : featured.data.illustration === 'devotional' ? (
            <DevotionalArt />
          ) : (
            <BeforeAfter beforeImage={featured.data.beforeImage} afterImage={featured.data.afterImage} />
          )}
        </div>
        <div class="featured-copy">
          <p class="eyebrow">Featured project</p>
          <h2>{featured.data.title}</h2>
          <p class="muted">{featured.data.summary}</p>
          <ul class="pill-list">{featured.data.tools.map((t) => <li>{t}</li>)}</ul>
          <a href={`/work/${featured.id}/`} class="text-link">View case study →</a>
        </div>
      </div>
    </section>
  )}

  <!-- Writing (newest two articles, pulled automatically) -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">02 / Writing</p>
          <h2 class="section-title">Thinking about tech</h2>
        </div>
        <a href="/writing/" class="text-link">All writing →</a>
      </div>
      <div class="article-grid">
        {articles.map((a, i) => <ArticleCard article={a} variant={i} />)}
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="section section--tint">
    <div class="container about">
      <div>
        <p class="eyebrow">03 / About</p>
        <h2>Systems thinker. Problem solver. Technology human.</h2>
      </div>
      <div>
        <p class="muted big">I'm a technologist with a background in systems, data, and integrations. I care about building solutions that are reliable, useful, and designed with people in mind.</p>
        <a href="/about/" class="text-link">My journey →</a>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section">
    <div class="container">
      <div class="contact">
        <div class="contact-copy">
          <h2>Curious about working together?</h2>
          <p>I'm always interested in new opportunities, collaborations, and conversations.</p>
          <Star size={40} color="var(--mustard)" twinkle />
        </div>
        <div class="contact-form"><ContactForm /></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { display: flex; flex-wrap: wrap; align-items: center; gap: 48px; padding-top: 64px; padding-bottom: 80px; }
  .hero-copy { flex: 1 1 440px; min-width: 0; }
  .hero-copy .eyebrow { margin-bottom: 20px; }
  h1 { font-weight: 800; font-size: clamp(44px, 6vw, 84px); line-height: 1.02; letter-spacing: -0.01em; margin-bottom: 28px; text-wrap: balance; }
  .lede { margin: 0 0 36px; font-size: 19px; max-width: 520px; color: var(--ink-soft); }
  .hero-art { flex: 1 1 420px; min-width: 0; display: flex; justify-content: center; }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
  .cat { display: flex; align-items: center; gap: 24px; padding: 32px; border-radius: var(--radius); color: var(--ink); text-decoration: none; min-height: 140px; }
  .cat:hover { color: var(--ink); }
  .cat h3 { font-size: 26px; font-weight: 600; margin-bottom: 6px; }
  .cat p { margin: 0; }

  .featured { display: flex; flex-wrap: wrap; align-items: center; gap: 48px; }
  .featured-visual { flex: 1.2 1 420px; min-width: 0; }
  .featured-copy { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .featured-copy .eyebrow { margin: 0; }
  .featured-copy h2 { font-size: clamp(30px, 3.4vw, 42px); }
  .featured-copy .muted { margin: 0; }

  .article-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 360px)); gap: 24px; }
  .about { display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: center; }
  .about > div { flex: 1 1 320px; min-width: 0; }
  .about h2 { font-size: clamp(30px, 3.4vw, 42px); line-height: 1.2; }
  .big { font-size: 18px; margin: 0 0 20px; }

  .contact { background: var(--forest); color: var(--cream); border-radius: 18px; padding: 48px; display: flex; flex-wrap: wrap; gap: 32px 56px; }
  .contact-copy { flex: 1 1 300px; min-width: 0; }
  .contact-copy h2 { font-size: clamp(30px, 3.4vw, 40px); margin-bottom: 12px; }
  .contact-copy p { margin: 0 0 24px; max-width: 420px; color: #E9DCC6; }
  .contact-form { flex: 1.3 1 340px; min-width: 0; }
  @media (max-width: 600px) { .contact { padding: 28px 20px; } }
</style>