---
// One page is generated for every Markdown file in src/content/case-studies/.
// Like a Rock content channel item detail page.
//
// Stat strip: if a case study has `stats` in its frontmatter, the page shows
// them as big numbers under the header. Without stats, that section is skipped.
//
// Sidebar: a quote if there is one, otherwise the `aside` illustration.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import GrowthTrackArt from '../../components/GrowthTrackArt.astro';
import DevotionalArt from '../../components/DevotionalArt.astro';
import ConnectionsArt from '../../components/ConnectionsArt.astro';
import PaperPlaneArt from '../../components/PaperPlaneArt.astro';
import JourneyArt from '../../components/JourneyArt.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { getCaseStudies } from '../../lib/content';

export async function getStaticPaths() {
  const studies = await getCaseStudies();
  return studies.map((study) => ({ params: { id: study.id }, props: { study } }));
}

const { study } = Astro.props;
const { title, summary, tools, stats, aside, quote, beforeImage, afterImage, illustration, featured, video, poster, videoLabel } = study.data;
const { Content } = await render(study);

const hasStats = Array.isArray(stats) && stats.length > 0;
---
<BaseLayout title={title} description={summary}>
  <article>
    <header class="section container head">
      <div class="head-copy">
        <a href="/work/" class="back">← Back to work</a>
        <h1>{title}</h1>
        <ul class="pill-list">{tools.map((t) => <li>{t}</li>)}</ul>
        <p class="muted lede">{summary}</p>
      </div>
      {video ? (
        <figure class="head-visual video-wrap" data-video>
          <video
            class="head-video"
            src={video}
            poster={poster}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={videoLabel ?? `Walkthrough of ${title}`}
          ></video>
          <button type="button" class="video-toggle" data-video-toggle aria-label="Pause video">
            <svg class="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
            <svg class="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"></path></svg>
          </button>
        </figure>
      ) : illustration === 'growth-track' ? (
        <div class="head-visual"><GrowthTrackArt /></div>
      ) : illustration === 'connections' ? (
        <div class="head-visual"><ConnectionsArt /></div>
      ) : illustration === 'devotional' ? (
        <div class="head-visual"><DevotionalArt /></div>
      ) : (beforeImage || afterImage || featured || illustration === 'before-after') && (
        <div class="head-visual"><BeforeAfter beforeImage={beforeImage} afterImage={afterImage} /></div>
      )}
    </header>

    {hasStats && (
      <section class="section--border">
        <div class="container">
          <dl class="stats" style={`--count: ${stats.length}`}>
            {stats.map((s) => (
              <div class="stat">
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    <section class="section section--tint">
      <div class="container body">
        <div class="prose"><Content /></div>
        {quote ? (
          <QuoteCard quote={quote} />
        ) : aside === 'paper-plane' ? (
          <aside class="side-art">
            <PaperPlaneArt />
          </aside>
        ) : aside === 'journey' && (
          <aside class="side-art">
            <JourneyArt />
          </aside>
        )}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .head { display: flex; flex-wrap: wrap; gap: 40px; align-items: center; }
  .head-copy { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .head-visual { flex: 1 1 400px; min-width: 0; }
  .back { font-size: 14px; color: var(--ink-soft); text-decoration: none; }
  h1 { font-size: clamp(38px, 5vw, 60px); }
  .lede { margin: 0; font-size: 18px; }

  /* ---------- Stat strip ----------
     Centered columns with thin dividers between them.
     --count is set inline from the number of stats, so two or three both fill evenly.
     <dt> (label) comes first in the markup for screen readers,
     but column-reverse shows the big number on top. */
  .stats {
    display: grid;
    grid-template-columns: repeat(var(--count, 3), minmax(0, 1fr));
    max-width: 980px;
    margin: 0 auto;
    padding: 56px 0;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 10px;
    padding: 4px 28px;
    text-align: center;
  }
  .stat + .stat { border-left: 1px solid var(--line-strong); }
  .stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(36px, 4.4vw, 54px);
    line-height: 1;
    color: var(--terracotta);
    white-space: nowrap;
  }
  .stat dt { font-size: 15px; line-height: 1.5; color: var(--ink-soft); max-width: 24ch; }

  /* Stack on phones, dividers become horizontal */
  @media (max-width: 720px) {
    .stats { grid-template-columns: 1fr; padding: 40px 0; }
    .stat { padding: 24px 0; }
    .stat + .stat { border-left: 0; border-top: 1px solid var(--line-strong); }
  }

  .body { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; }
  .prose { flex: 2 1 480px; min-width: 0; }
  .side-art { flex: 1 1 260px; position: sticky; top: 24px; display: flex; justify-content: center; }
  @media (max-width: 800px) { .side-art { position: static; } }

  /* ---------- Header video ---------- */
  .video-wrap { position: relative; margin: 0; }
  .head-video {
    display: block; width: 100%; height: auto;
    border-radius: var(--radius); border: 1px solid var(--line);
    background: var(--paper);
  }
  .video-toggle {
    position: absolute; right: 12px; bottom: 12px;
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; cursor: pointer;
    background: var(--paper); color: var(--ink); border: 1px solid var(--line-strong);
    opacity: .85; transition: opacity .2s ease, background-color .2s ease, color .2s ease;
  }
  .video-toggle:hover, .video-toggle:focus-visible { opacity: 1; background: var(--ink); color: var(--cream); }
  .video-toggle:focus-visible { outline: 3px solid var(--mustard); outline-offset: 3px; }
  .video-toggle .icon-play { display: none; }
  .video-toggle[aria-pressed='true'] .icon-pause { display: none; }
  .video-toggle[aria-pressed='true'] .icon-play { display: block; }
</style>

<script>
  // Header video: pause/play button, and no autoplay for reduced-motion users
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((wrap) => {
    const video = wrap.querySelector('video');
    const btn = wrap.querySelector<HTMLButtonElement>('[data-video-toggle]');
    if (!video || !btn) return;

    const sync = () => {
      const paused = video.paused;
      btn.setAttribute('aria-pressed', String(paused));
      btn.setAttribute('aria-label', paused ? 'Play video' : 'Pause video');
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
    }

    btn.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    sync();
  });
</script>